<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Not connected"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Pages -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Remote -->
        <ScrollView
            android:id="@+id/pageRemote"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPower"
                        style="@style/RemoteButton"
                        android:background="@drawable/btn_power_bg"
                        android:contentDescription="Power"
                        android:src="@drawable/ic_power" />

                    <Button
                        android:id="@+id/btnSource"
                        style="@style/RemoteButton"
                        android:text="Source" />

                    <Button
                        android:id="@+id/btnMenu"
                        style="@style/RemoteButton"
                        android:text="Menu" />
                </LinearLayout>

                <!-- D-pad -->
                <FrameLayout
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/dpad_bg">

                    <ImageButton
                        android:id="@+id/btnUp"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/arrow_bg"
                        android:contentDescription="Up"
                        android:rotation="270"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/btnDown"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/arrow_bg"
                        android:contentDescription="Down"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/btnLeft"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/arrow_bg"
                        android:contentDescription="Left"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/btnRight"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/arrow_bg"
                        android:contentDescription="Right"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text" />

                    <Button
                        android:id="@+id/btnOk"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ok_bg"
                        android:stateListAnimator="@null"
                        android:text="OK"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBack"
                        style="@style/RemoteButton"
                        android:text="Back" />

                    <Button
                        android:id="@+id/btnHome"
                        style="@style/RemoteButton"
                        android:text="Home" />

                    <Button
                        android:id="@+id/btnExit"
                        style="@style/RemoteButton"
                        android:text="Exit" />
                </LinearLayout>

                <!-- Volume and channel rockers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnVolUp"
                            style="@style/ColumnButton"
                            android:text="Vol +" />

                        <Button
                            android:id="@+id/btnMute"
                            style="@style/ColumnButton"
                            android:text="Mute" />

                        <Button
                            android:id="@+id/btnVolDown"
                            style="@style/ColumnButton"
                            android:text="Vol -" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnChUp"
                            style="@style/ColumnButton"
                            android:text="Ch +" />

                        <Button
                            android:id="@+id/btnInfo"
                            style="@style/ColumnButton"
                            android:text="Info" />

                        <Button
                            android:id="@+id/btnChDown"
                            style="@style/ColumnButton"
                            android:text="Ch -" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRew"
                        style="@style/RemoteButton"
                        android:text="Rewind"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPlay"
                        style="@style/RemoteButton"
                        android:text="Play"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPause"
                        style="@style/RemoteButton"
                        android:text="Pause"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnFf"
                        style="@style/RemoteButton"
                        android:text="Forward"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:text="Your phone's volume buttons control the TV while this app is open. Hold a direction or volume button to repeat." />
            </LinearLayout>
        </ScrollView>

        <!-- Apps -->
        <LinearLayout
            android:id="@+id/pageApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp">

                <TextView
                    android:id="@+id/appsStatus"
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Connect to your TV to load its apps." />

                <Button
                    android:id="@+id/btnRefreshApps"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/btn_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <GridLayout
                    android:id="@+id/appsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />
            </ScrollView>
        </LinearLayout>

        <!-- Keyboard -->
        <LinearLayout
            android:id="@+id/pageKeyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/kbStatus"
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                android:text="Open a search or text box on the TV, then type here." />

            <EditText
                android:id="@+id/kbInput"
                style="@style/Field"
                android:hint="Type here"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKbSend"
                    style="@style/RemoteButton"
                    android:background="@drawable/ok_bg_rect"
                    android:text="Send" />

                <Button
                    android:id="@+id/btnKbEnter"
                    style="@style/RemoteButton"
                    android:text="Enter" />

                <Button
                    android:id="@+id/btnKbClear"
                    style="@style/RemoteButton"
                    android:text="Clear" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Send replaces the text in the TV's box. Enter submits the search on the TV." />
        </LinearLayout>
    </FrameLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabRemote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Remote"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Apps"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabKeyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Keyboard"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
